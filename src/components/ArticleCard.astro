---
import { format } from 'date-fns';
import { formatCategoryLabel } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  category?: string;
  href: string;
  class?: string;
}

const { title, description, date, tags, category, href, class: className } = Astro.props;
const categoryLabel = formatCategoryLabel(category);
---
<a
  href={href}
  class={`group block bg-card rounded-[16px] p-7 border border-border/80 shadow-[0_1px_4px_rgba(0,0,0,0.02)] transition-all duration-200 hover:border-accent hover:shadow-[0_4px_20px_rgba(0,0,0,0.04)] focus:outline-none focus:border-accent ${className || ""}`}
>
  <div class="flex flex-col h-full">
    <div class="font-mono text-xs text-accent lowercase mb-3">
      agentic diaries / {format(date, "MMM d, yyyy")}
    </div>
    
    <h3 class="font-heading text-xl font-bold tracking-tight text-foreground mb-3 group-hover:text-accent transition-colors line-clamp-2">
      {title}
    </h3>
    
    <p class="text-[#4a4a4a] text-sm leading-relaxed mb-6 line-clamp-3 flex-grow">
      {description}
    </p>
    
    {tags && tags.length > 0 && (
      <div class="pt-4 border-t border-border/40 mt-auto font-mono text-xs text-[#767676] lowercase">
        tags: {tags.slice(0, 3).map((tag) => `#${tag}`).join('  ')}
      </div>
    )}
  </div>
</a>
