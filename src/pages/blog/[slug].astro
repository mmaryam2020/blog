---
import { getUnifiedPosts } from '../../lib/posts';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { format } from 'date-fns';
import htmlPostReadingCss from '../../styles/html-post-reading.css?raw';

export async function getStaticPaths() {
  const posts = await getUnifiedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

let Content = null;
if (!post.isHtml && post._originalEntry) {
  const rendered = await post._originalEntry.render();
  Content = rendered.Content;
}

const getReadingTime = (body: string) => {
  const wordsPerMinute = 200;
  const words = body.trim().split(/\s+/).length;
  return Math.ceil(words / wordsPerMinute).toString();
};
const isFullHtml = post.isHtml && (post.body.includes('<h1') || post.body.includes('<H1'));

let htmlBody = post.body;
if (post.isHtml) {
  let readTime = "5";
  if (post.slug.toLowerCase().includes('workout')) {
    readTime = "6";
  } else {
    try {
      const clean = post.body
        .replace(/<style[\s\S]*?<\/style>/gi, '')
        .replace(/<script[\s\S]*?<\/script>/gi, '')
        .replace(/<[^>]+>/g, ' ');
      const words = clean.trim().split(/\s+/).filter(Boolean).length;
      readTime = Math.max(1, Math.ceil(words / 200)).toString();
    } catch {
      readTime = "5";
    }
  }

  const dateStr = format(post.data.date, "MMM d, yyyy");
  const metaLine = `agentic diaries / ${dateStr} / ${readTime} min read`;

  // Standardize header meta line and strip top category/tags from all HTML posts
  htmlBody = htmlBody.replace(/<div class="header-top">[\s\S]*?<\/div>/i, `<div class="header-top">${metaLine}</div>`);
  htmlBody = htmlBody.replace(/<div class="tags-row">[\s\S]*?<\/div>/i, '');

  // Add plain mono tags to bottom of HTML post if present
  if (post.data.tags && post.data.tags.length > 0 && !htmlBody.includes('class="footer-tags"')) {
    const tagsHtml = `<div class="footer-tags">tags: ${post.data.tags.map((t: string) => `#${t}`).join('  ')}</div>`;
    if (htmlBody.includes('</main>')) {
      htmlBody = htmlBody.replace('</main>', `${tagsHtml}\n</main>`);
    } else if (htmlBody.includes('</div>')) {
      const lastDiv = htmlBody.lastIndexOf('</div>');
      htmlBody = htmlBody.slice(0, lastDiv) + tagsHtml + '\n' + htmlBody.slice(lastDiv);
    }
  }
}

const iframeBody = post.isHtml
  ? htmlBody.includes('</head>')
    ? htmlBody.replace('</head>', `<style>${htmlPostReadingCss}</style></head>`)
    : `<style>${htmlPostReadingCss}</style>\n${htmlBody}`
  : post.body;
---
<Layout title={`${post.data.title} | Agentic Building Diaries`} description={post.data.description}>
  <Navbar />
  <main class={`flex-1 w-full mx-auto px-4 md:px-6 py-12 md:py-16 ${isFullHtml ? "max-w-6xl" : "max-w-3xl"}`}>
    <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground mb-6 transition-colors font-medium">
      &larr; Back to blog
    </a>
    
    {isFullHtml ? (
      <iframe
        srcdoc={iframeBody}
        scrolling="no"
        class="w-full border-none overflow-hidden"
        style="min-height: 800px; transition: height 0.25s ease;"
        onload="
          const iframe = this;
          const resize = () => {
            if (iframe.contentWindow?.document?.documentElement) {
              // Ensure height fits content perfectly and no inner scrollbar appears
              if (iframe.contentWindow.document.documentElement) {
                iframe.contentWindow.document.documentElement.style.overflow = 'hidden';
                iframe.contentWindow.document.body.style.overflow = 'hidden';
              }
              iframe.style.height = (iframe.contentWindow.document.documentElement.scrollHeight + 10) + 'px';
            }
          };
          resize();
          // Resize on full load
          iframe.contentWindow.addEventListener('load', resize);
          // Resize on window resize
          window.addEventListener('resize', resize);
          // Observe DOM mutations to auto-adjust height when content/themes change dynamically
          if (iframe.contentWindow.MutationObserver) {
            new iframe.contentWindow.MutationObserver(resize).observe(
              iframe.contentWindow.document.documentElement,
              { subtree: true, childList: true, attributes: true }
            );
          }
        "
      />
    ) : (
      <div class="bg-card border border-border/80 rounded-[16px] p-8 md:p-12 shadow-[0_1px_4px_rgba(0,0,0,0.03)]">
        <article class="prose">
          <div class="mb-8 pb-6 border-b border-border/60">
            <div class="font-mono text-xs md:text-sm text-[#3b3bd1] lowercase mb-4 tracking-normal">
              agentic diaries / {format(post.data.date, "MMM d, yyyy")} / {getReadingTime(post.body)} min read
            </div>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-primary mb-4 leading-tight font-heading">
              {post.data.title}
            </h1>
            <p class="text-lg text-[#4a4a4a] leading-relaxed">
              {post.data.description}
            </p>
          </div>
          
          {post.isHtml ? (
            <Fragment set:html={post.body} />
          ) : (
            Content && <Content />
          )}

          {post.data.tags && post.data.tags.length > 0 && (
            <div class="mt-12 pt-6 border-t border-border font-mono text-xs md:text-sm text-[#4a4a4a] lowercase">
              tags: {post.data.tags.map((tag: string) => `#${tag}`).join('  ')}
            </div>
          )}
        </article>
      </div>
    )}

  </main>
</Layout>

