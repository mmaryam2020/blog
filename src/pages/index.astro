---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getUnifiedPosts } from '../lib/posts';

const sortedPosts = await getUnifiedPosts();
const latestPosts = sortedPosts.slice(0, 3);

// Helper to calculate reading time
const getReadingTime = (body: string) => {
  const wordsPerMinute = 200;
  const words = body.trim().split(/\s+/).length;
  return Math.ceil(words / wordsPerMinute).toString();
};
---
<Layout
  title="Agentic Diaries"
  description="Notes from building AI systems, thinking through messy ideas, and figuring things out in public."
>
  <Navbar />
  <main class="flex-1 w-full max-w-5xl mx-auto px-6 py-20 md:py-32">
    <section class="flex flex-col items-center text-center mb-24 md:mb-28">
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-primary mb-6 leading-tight">
        Agentic Diaries
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-2xl font-medium leading-relaxed">
        Notes from building AI systems, thinking through messy ideas, and figuring things out in public.
      </p>
    </section>

    <section class="mb-24">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold tracking-tight text-primary">Latest Writing</h2>
        <a href="/blog" class="text-sm font-medium text-accent hover:underline">
          View all
        </a>
      </div>
      
      {latestPosts.length === 0 ? (
        <div class="text-center py-20 bg-card rounded-[24px] border border-border/50">
          <p class="text-muted-foreground">No posts found yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              readingTime={getReadingTime(post.body)}
              tags={post.data.tags}
              category={post.data.category}
              href={`/blog/${post.slug}`}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>
