---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getUnifiedPosts } from '../lib/posts';
import { format } from 'date-fns';
import { formatCategoryLabel } from '../lib/utils';

const sortedPosts = await getUnifiedPosts();
const featuredPost = sortedPosts.find((post) => post.data.featured) ?? sortedPosts[0];
const remainingPosts = sortedPosts.filter((post) => post.slug !== featuredPost?.slug);
const latestPosts = remainingPosts.slice(0, 3);
---
<Layout
  title="Agentic Diaries"
  description="Notes from building AI systems, thinking through messy ideas, and figuring things out in public."
>
  <Navbar />
  <main class="flex-1 w-full max-w-5xl mx-auto px-6 py-20 md:py-32">
    <section class="flex flex-col items-center text-center mb-20 md:mb-24">
      <span class="px-3 py-1 text-xs font-bold tracking-[0.2em] uppercase bg-accent-background text-accent rounded-full mb-5 inline-block border border-accent/20">
        Personal systems, public thinking
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-primary mb-6 leading-tight max-w-4xl">
        Agentic Diaries
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-2xl font-medium leading-relaxed">
        Notes from building AI systems, thinking through messy ideas, and figuring things out in public.
      </p>
    </section>

    {featuredPost && (
      <section class="mb-24">
        <div class="rounded-[32px] border border-border/80 bg-card p-8 md:p-10 shadow-[0_10px_40px_rgba(0,0,0,0.04)]">
          <div class="flex items-center gap-3 mb-5 flex-wrap">
            <span class="px-3 py-1 text-xs font-bold tracking-[0.18em] uppercase bg-accent text-white rounded-full">
              Start here
            </span>
            {featuredPost.data.category && (
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
                {formatCategoryLabel(featuredPost.data.category)}
              </span>
            )}
            <span class="text-sm text-muted-foreground">
              {format(featuredPost.data.date, "MMMM d, yyyy")}
            </span>
          </div>

          <div class="grid gap-8 md:grid-cols-[1.4fr_0.8fr] md:items-end">
            <div>
              <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight text-primary leading-tight mb-4">
                <a href={`/blog/${featuredPost.slug}`} class="hover:text-accent transition-colors">
                  {featuredPost.data.title}
                </a>
              </h2>
              <p class="text-lg text-muted-foreground leading-relaxed max-w-2xl">
                {featuredPost.data.description}
              </p>
            </div>

            <div class="border border-border/70 rounded-[24px] p-5 bg-background">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-accent mb-2">
                Featured post
              </p>
              <p class="text-sm text-muted-foreground leading-relaxed mb-5">
                Start here if you want the clearest feel for the kind of writing this site is about.
              </p>
              <a
                href={`/blog/${featuredPost.slug}`}
                class="inline-flex items-center gap-2 text-sm font-semibold text-foreground hover:text-accent transition-colors"
              >
                Read the featured essay
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="mb-24">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-primary">Latest Writing</h2>
          <p class="text-sm text-muted-foreground mt-2">
            Specific stories about AI, memory, attention, and the systems underneath the feeling.
          </p>
        </div>
        <a href="/blog" class="text-sm font-medium text-accent hover:underline">
          View all
        </a>
      </div>
      
      {latestPosts.length === 0 ? (
        <div class="text-center py-20 bg-card rounded-[24px] border border-border/50">
          <p class="text-muted-foreground">No posts found yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              category={post.data.category}
              href={`/blog/${post.slug}`}
            />
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>
