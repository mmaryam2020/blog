---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getUnifiedPosts } from '../lib/posts';
import { format } from 'date-fns';
import { formatCategoryLabel, isEducationPost } from '../lib/utils';

const allPosts = await getUnifiedPosts();
const essayPosts = allPosts.filter(post => !isEducationPost(post.data.category));
const learnPosts = allPosts.filter(post => isEducationPost(post.data.category));

const featuredPost = essayPosts.find((post) => post.data.featured) ?? essayPosts[0];
const latestEssayPosts = essayPosts.slice(0, 3);
const latestLearnPosts = learnPosts.slice(0, 3);
---
<Layout
  title="Agentic Diaries"
  description="Notes from building AI systems, thinking through messy ideas, and figuring things out in public."
>
  <Navbar />
  <main class="flex-1 w-full max-w-5xl mx-auto px-6 py-20 md:py-32">
    <section class="flex flex-col items-center text-center mb-20 md:mb-24">
      <div class="relative mb-6 inline-block">
        <div class="w-32 h-32 mx-auto hover:-translate-y-2 transition-transform duration-300">
          <svg viewBox="0 0 120 130" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-md"><path d="M 40 30 Q 30 15 25 18" fill="none" stroke="#facc15" stroke-width="5" stroke-linecap="round"/><circle cx="23" cy="18" r="6" fill="#facc15"/><path d="M 80 30 Q 90 15 95 18" fill="none" stroke="#facc15" stroke-width="5" stroke-linecap="round"/><circle cx="97" cy="18" r="6" fill="#facc15"/><path d="M 60 25 C 28 25, 25 60, 25 85 C 25 105, 35 125, 42 120 C 50 115, 55 105, 60 95 C 65 105, 70 115, 78 120 C 85 125, 95 105, 95 85 C 95 60, 92 25, 60 25 Z" fill="#fb923c"/><circle cx="60" cy="52" r="14" fill="#ffffff"/><circle cx="60" cy="52" r="7" fill="#0f172a"/><circle cx="58" cy="50" r="2.5" fill="#ffffff"/><path d="M 42 75 Q 60 90 78 75 Z" fill="#0f172a"/><polygon points="45,75 49,81 53,75 57,81 61,75 65,81 69,75 73,81 75,75" fill="#ffffff"/></svg>
        </div>
        
        <div class="absolute top-4 left-full ml-4 hidden md:block w-52 text-left">
          <div class="relative bg-card border border-border/80 shadow-sm rounded-2xl p-4">
            <div class="absolute top-6 -left-2 w-4 h-4 bg-card border-l border-t border-border/80 -rotate-45"></div>
            <p class="font-bold text-sm text-foreground mb-1">I'm Ollie! 👋</p>
            <p class="text-xs text-muted-foreground leading-relaxed">I'm an interactive learning companion. My friends and I help explain complex topics in the Learn section.</p>
          </div>
        </div>
      </div>
      <h1 class="font-heading text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-4 leading-tight max-w-4xl">
        Hi, I'm Maryam.
      </h1>
      <p class="text-lg md:text-xl text-[#4a4a4a] max-w-2xl font-medium leading-relaxed mb-8">
        I build agent systems and teach how they work. To make the technical concepts clearer, I build interactive learning companions (like Ollie!) to guide you through my tutorials.
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-4 text-sm font-semibold">
        {featuredPost && (
          <a href={`/blog/${featuredPost.slug}`} class="bg-foreground text-background px-6 py-3 rounded-full hover:bg-accent hover:text-white transition-colors">
            Read the featured essay &rarr;
          </a>
        )}
        <a href="/about" class="text-[#4a4a4a] hover:text-foreground transition-colors px-4 py-3">
          About me &rarr;
        </a>
      </div>
    </section>

    {featuredPost && (
      <section class="mb-24">
        <div class="rounded-[20px] border border-border/80 bg-card p-8 md:p-10 shadow-[0_1px_4px_rgba(0,0,0,0.02)]">
          <div class="font-mono text-xs text-accent lowercase mb-4">
            featured / {format(featuredPost.data.date, "MMM d, yyyy")}
          </div>

          <div class="grid gap-8 md:grid-cols-[1.4fr_0.8fr] md:items-end">
            <div>
              <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight text-foreground leading-tight mb-4">
                <a href={`/blog/${featuredPost.slug}`} class="hover:text-accent transition-colors">
                  {featuredPost.data.title}
                </a>
              </h2>
              <p class="text-lg text-[#4a4a4a] leading-relaxed max-w-2xl">
                {featuredPost.data.description}
              </p>
            </div>

            <div class="border border-border/70 rounded-[16px] p-5 bg-card">
              <p class="font-mono text-xs text-accent lowercase mb-2">
                start here
              </p>
              <p class="text-sm text-[#4a4a4a] leading-relaxed mb-5">
                Start here if you want the clearest feel for the kind of writing this site is about.
              </p>
              <a
                href={`/blog/${featuredPost.slug}`}
                class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:underline transition-colors"
              >
                Read the featured essay
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="mb-24">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="font-heading text-2xl font-bold tracking-tight text-foreground">Latest Writing</h2>
          <p class="text-sm text-[#4a4a4a] mt-2">
            Specific stories about AI, memory, attention, and the systems underneath the feeling.
          </p>
        </div>
        <a href="/blog" class="font-mono text-xs text-accent hover:underline lowercase">
          view all &rarr;
        </a>
      </div>
      
      {latestEssayPosts.length === 0 ? (
        <div class="text-center py-20 bg-card rounded-[24px] border border-border/50">
          <p class="text-muted-foreground">No posts found yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestEssayPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              category={post.data.category}
              href={`/blog/${post.slug}`}
            />
          ))}
        </div>
      )}
    </section>

    <section class="mb-24">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="font-heading text-2xl font-bold tracking-tight text-foreground">Learn</h2>
          <p class="text-sm text-[#4a4a4a] mt-2">
            Digests, explainers, tutorials, and talk slides.
          </p>
        </div>
        <a href="/learn" class="font-mono text-xs text-accent hover:underline lowercase">
          view all &rarr;
        </a>
      </div>
      
      {latestLearnPosts.length === 0 ? (
        <div class="text-center py-20 bg-card rounded-[24px] border border-border/50">
          <p class="text-muted-foreground">No learn posts found yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {latestLearnPosts.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              category={post.data.category}
              href={`/blog/${post.slug}`}
            />
          ))}
        </div>
      )}
    </section>

    <section class="mt-20 pt-16 border-t border-border/50 text-center">
      <h2 class="text-2xl font-bold font-heading mb-2">Meet the Companions</h2>
      <p class="text-muted-foreground mb-12 max-w-lg mx-auto">They pop up across the site to explain complex systems and guide you through tutorials.</p>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 max-w-4xl mx-auto">
        <div class="flex flex-col items-center group cursor-default">
          <div class="w-16 h-16 mb-3 transition-transform duration-300 group-hover:-translate-y-2 group-hover:scale-110 drop-shadow-sm">
            <svg viewBox="0 0 120 130" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><path d="M 40 30 Q 30 15 25 18" fill="none" stroke="#facc15" stroke-width="5" stroke-linecap="round"/><circle cx="23" cy="18" r="6" fill="#facc15"/><path d="M 80 30 Q 90 15 95 18" fill="none" stroke="#facc15" stroke-width="5" stroke-linecap="round"/><circle cx="97" cy="18" r="6" fill="#facc15"/><path d="M 60 25 C 28 25, 25 60, 25 85 C 25 105, 35 125, 42 120 C 50 115, 55 105, 60 95 C 65 105, 70 115, 78 120 C 85 125, 95 105, 95 85 C 95 60, 92 25, 60 25 Z" fill="#fb923c"/><circle cx="60" cy="52" r="14" fill="#ffffff"/><circle cx="60" cy="52" r="7" fill="#0f172a"/><circle cx="58" cy="50" r="2.5" fill="#ffffff"/><path d="M 42 75 Q 60 90 78 75 Z" fill="#0f172a"/><polygon points="45,75 49,81 53,75 57,81 61,75 65,81 69,75 73,81 75,75" fill="#ffffff"/></svg>
          </div>
          <span class="text-sm font-semibold">Ollie</span>
        </div>
        
        <div class="flex flex-col items-center group cursor-default">
          <div class="w-16 h-16 mb-3 transition-transform duration-300 group-hover:-translate-y-2 group-hover:scale-110 drop-shadow-sm">
            <svg viewBox="0 0 120 130" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><polygon points="42,32 46,14 54,28 60,10 66,28 74,14 78,32" fill="#7e22ce"/><ellipse cx="60" cy="70" rx="36" ry="34" fill="#c084fc"/><circle cx="44" cy="58" r="6.5" fill="#ffffff"/><circle cx="44" cy="58" r="3.5" fill="#0f172a"/><circle cx="43" cy="57" r="1.2" fill="#ffffff"/><circle cx="60" cy="56" r="7.5" fill="#ffffff"/><circle cx="60" cy="56" r="4" fill="#0f172a"/><circle cx="59" cy="55" r="1.5" fill="#ffffff"/><circle cx="76" cy="58" r="6.5" fill="#ffffff"/><circle cx="76" cy="58" r="3.5" fill="#0f172a"/><circle cx="75" cy="57" r="1.2" fill="#ffffff"/><path d="M 50 78 Q 60 86 70 78" fill="none" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round"/><path d="M 62 82 C 62 88, 70 88, 70 82 Z" fill="#f43f5e"/><path d="M 28 66 Q 16 54 18 52" fill="none" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/><path d="M 92 66 Q 104 54 102 52" fill="none" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/><rect x="44" y="100" width="8" height="12" rx="4" fill="#7e22ce"/><rect x="68" y="100" width="8" height="12" rx="4" fill="#7e22ce"/></svg>
          </div>
          <span class="text-sm font-semibold">Pip</span>
        </div>
        
        <div class="flex flex-col items-center group cursor-default">
          <div class="w-16 h-16 mb-3 transition-transform duration-300 group-hover:-translate-y-2 group-hover:scale-110 drop-shadow-sm">
            <svg viewBox="0 0 120 130" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><path d="M 44 65 Q 26 30 24 16" fill="none" stroke="#38bdf8" stroke-width="7" stroke-linecap="round"/><circle cx="24" cy="16" r="10" fill="#ffffff"/><circle cx="24" cy="16" r="5" fill="#0f172a"/><path d="M 76 65 Q 94 30 96 16" fill="none" stroke="#38bdf8" stroke-width="7" stroke-linecap="round"/><circle cx="96" cy="16" r="10" fill="#ffffff"/><circle cx="96" cy="16" r="5" fill="#0f172a"/><path d="M 30 75 C 30 55, 90 55, 95 75 C 100 95, 115 105, 115 110 C 115 118, 30 118, 30 110 Z" fill="#38bdf8"/><path d="M 48 90 Q 55 96 62 90 Q 69 96 76 90" fill="none" stroke="#0f172a" stroke-width="4" stroke-linecap="round"/></svg>
          </div>
          <span class="text-sm font-semibold">Sluggy</span>
        </div>

        <div class="flex flex-col items-center group cursor-default">
          <div class="w-16 h-16 mb-3 transition-transform duration-300 group-hover:-translate-y-2 group-hover:scale-110 drop-shadow-sm">
            <svg viewBox="0 0 120 130" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><path d="M 45 35 C 40 25, 32 20, 36 12 C 40 5, 50 12, 44 22" fill="none" stroke="#eab308" stroke-width="4.5" stroke-linecap="round"/><path d="M 75 35 C 80 25, 88 20, 84 12 C 80 5, 70 12, 76 22" fill="none" stroke="#eab308" stroke-width="4.5" stroke-linecap="round"/><rect x="30" y="35" width="60" height="55" rx="12" fill="#facc15"/><path d="M 30 55 C 18 55, 15 72, 30 76" fill="none" stroke="#eab308" stroke-width="5.5" stroke-linecap="round"/><path d="M 90 55 C 102 55, 105 72, 90 76" fill="none" stroke="#eab308" stroke-width="5.5" stroke-linecap="round"/><rect x="38" y="44" width="44" height="26" rx="8" fill="#ffffff"/><circle cx="60" cy="57" r="7.5" fill="#0f172a"/><circle cx="58" cy="55" r="2.5" fill="#ffffff"/><path d="M 52 78 Q 62 84 72 76" fill="none" stroke="#0f172a" stroke-width="4" stroke-linecap="round"/><path d="M 45 90 L 45 102 C 45 106, 38 106, 38 102" fill="none" stroke="#eab308" stroke-width="6" stroke-linecap="round"/><path d="M 75 90 L 75 102 C 75 106, 82 106, 82 102" fill="none" stroke="#eab308" stroke-width="6" stroke-linecap="round"/></svg>
          </div>
          <span class="text-sm font-semibold">Boxy</span>
        </div>

        <div class="flex flex-col items-center group cursor-default">
          <div class="w-16 h-16 mb-3 transition-transform duration-300 group-hover:-translate-y-2 group-hover:scale-110 drop-shadow-sm">
            <svg viewBox="0 0 120 130" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><circle cx="60" cy="62" r="32" fill="#3b82f6"/><path d="M 34 52 C 16 54, 18 84, 22 92" fill="none" stroke="#3b82f6" stroke-width="8" stroke-linecap="round"/><path d="M 86 52 C 104 54, 102 84, 98 92" fill="none" stroke="#3b82f6" stroke-width="8" stroke-linecap="round"/><circle cx="50" cy="50" r="6" fill="#ffffff"/><circle cx="50" cy="50" r="3" fill="#0f172a"/><circle cx="70" cy="50" r="6" fill="#ffffff"/><circle cx="70" cy="50" r="3" fill="#0f172a"/><path d="M 44 68 Q 60 62 76 68 Q 76 86 60 86 Q 44 86 44 68 Z" fill="#0f172a"/><polygon points="46,68 50,75 54,68 58,75 62,68 66,75 70,68 74,75" fill="#ffffff"/><polygon points="46,86 50,79 54,86 58,79 62,86 66,79 70,86 74,79" fill="#ffffff"/><rect x="46" y="90" width="9" height="18" rx="4" fill="#1d4ed8"/><rect x="65" y="90" width="9" height="18" rx="4" fill="#1d4ed8"/></svg>
          </div>
          <span class="text-sm font-semibold">Grum</span>
        </div>

        <div class="flex flex-col items-center group cursor-default">
          <div class="w-16 h-16 mb-3 transition-transform duration-300 group-hover:-translate-y-2 group-hover:scale-110 drop-shadow-sm">
            <svg viewBox="0 0 120 130" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><path d="M 48 48 Q 36 26 36 18" fill="none" stroke="#ef4444" stroke-width="4.5" stroke-linecap="round"/><circle cx="36" cy="18" r="7" fill="#ffffff"/><circle cx="36" cy="18" r="3.5" fill="#ef4444"/><path d="M 72 48 Q 84 26 84 18" fill="none" stroke="#ef4444" stroke-width="4.5" stroke-linecap="round"/><circle cx="84" cy="18" r="7" fill="#ffffff"/><circle cx="84" cy="18" r="3.5" fill="#ef4444"/><circle cx="60" cy="70" r="28" fill="#ef4444"/><circle cx="60" cy="64" r="11" fill="#ffffff"/><circle cx="60" cy="64" r="5.5" fill="#0f172a"/><circle cx="58" cy="62" r="2" fill="#ffffff"/><path d="M 50 82 Q 60 88 70 82" fill="none" stroke="#0f172a" stroke-width="3.5" stroke-linecap="round"/><polygon points="63,83 67,83 65,88" fill="#ffffff"/><path d="M 48 96 L 48 114 C 48 118, 40 118, 40 114" fill="none" stroke="#dc2626" stroke-width="5" stroke-linecap="round"/><path d="M 72 96 L 72 114 C 72 118, 80 118, 80 114" fill="none" stroke="#dc2626" stroke-width="5" stroke-linecap="round"/></svg>
          </div>
          <span class="text-sm font-semibold">Radar</span>
        </div>
      </div>
    </section>
  </main>
</Layout>
