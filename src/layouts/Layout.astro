---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleData?: {
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    author?: string;
    tags?: string[];
  };
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = "Notes from building AI systems, thinking through messy ideas, and figuring things out in public.",
  image = '/social-preview.png',
  articleData,
  jsonLd,
} = Astro.props;

// Ensure we don't serve .svg to social platforms like LinkedIn
const rasterImage = image.endsWith('.svg') ? image.replace(/\.svg$/, '.png') : image;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const socialImageUrl = new URL(rasterImage, Astro.site ?? Astro.url.origin).toString();
const isArticle = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/';
const imageType = socialImageUrl.endsWith('.png')
  ? 'image/png'
  : socialImageUrl.endsWith('.jpg') || socialImageUrl.endsWith('.jpeg')
  ? 'image/jpeg'
  : undefined;

const authorName = articleData?.author ?? "Maryam Moadeli";
const publishedTime = articleData?.publishedTime ? new Date(articleData.publishedTime).toISOString() : undefined;
const modifiedTime = articleData?.modifiedTime ? new Date(articleData.modifiedTime).toISOString() : undefined;
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Agentic Diaries" href="/rss.xml" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Agentic Diaries" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    {imageType && <meta property="og:image:type" content={imageType} />}

    <!-- Article specific Open Graph -->
    {isArticle && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {isArticle && <meta property="article:author" content={authorName} />}
    {isArticle && articleData?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MaryamMoad" />
    <meta name="twitter:creator" content="@MaryamMoad" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data (JSON-LD) -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-full flex flex-col">
    <slot />
  </body>
</html>
